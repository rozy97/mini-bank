APP_ENV=development
PORT=8080
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SSLMODE=disable

JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL=24h

# OpenTelemetry. Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to run without a
# collector — trace/span IDs still show up in logs for correlation, they're
# just never exported. docker-compose overrides this to point at the bundled
# Jaeger service.
OTEL_SERVICE_NAME=mini-bank
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_INSECURE=true
